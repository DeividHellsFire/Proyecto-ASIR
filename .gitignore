# Git ignore - GymTrack Docker / WordPress / Kubernetes

# Operating system
.DS_Store
Thumbs.db
Desktop.ini

# IDE / editors
.vscode/
.idea/
*.swp
*.swo
*~

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key

# WordPress runtime files
wp-content/uploads/
wp-content/cache/
wp-content/upgrade/
wp-content/backups/

# Local WordPress / Docker runtime
docker-data/
mysql-data/
mariadb-data/
wordpress-data/

# Database dumps / backups
*.sql
*.sql.gz
*.sql.zip
*.dump
*.bak

# Allow the documented project backup files to be tracked explicitly
!gymtrack-backup.sql
!k8s-backup/
!k8s-backup/*.sql
!k8s-backup/*.tar.gz

# Local generated Kubernetes / comparison files
k8s-diff.txt
php-diff.txt

# Temporary files
*.tmp
*.temp
*.log
*.cache

# Test output
tests/output/
tests/results/

# Python / Node artifacts if used by auxiliary tooling
__pycache__/
*.py[cod]
node_modules/
npm-debug.log*
yarn-debug.log*
